NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_TITLE=사이트 제목
NEXT_PUBLIC_SEO_DESC=사이트 설명
NEXT_PUBLIC_OG_IMAGE=/assets/img/facebook_ogp.png
NEXT_PUBLIC_FAVICON=/assets/img/favicon.png

NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=XXXXXXXXXX

NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

NEXT_PUBLIC_GITHUB_URL=https://github.com/username
NEXT_PUBLIC_EMAIL=you@example.com

# 포스트 데이터 소스. true: Supabase 직접 조회(레거시), false: server(Spring) API. 없으면 false
# 빌드 때 정해지므로 바꾸면 다시 배포해야 한다
USE_SUPABASE=false

# server(Spring) API. USE_SUPABASE=false일 때 필요. 빌드와 서버 렌더링에서만 쓴다 (NEXT_PUBLIC_ 아님)
API_URL=http://localhost:8080

# Supabase. USE_SUPABASE=true일 때와 scripts/migrate-posts.mjs에서 필요
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
