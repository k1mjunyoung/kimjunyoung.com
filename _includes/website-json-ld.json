{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site.title }}",
  "url": "{{ site.url }}/{{ page.lang }}",
  "description": "{{ site.seo.description[page.lang] }}",
  "inLanguage": "{{ page.lang }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "alternateName": ["김준영", "개발자 준영", "kimjunyoung", "k1mjunyoung"],
    "jobTitle": "{{ site.author.jobTitle }}",
    "url": "{{ site.url }}/{{ page.lang }}/about",
    "sameAs": [
      "https://github.com/{{ site.social.github }}",
      "https://x.com/{{ site.social.x }}",
      "https://instagram.com/{{ site.social.instagram }}",
      "https://linkedin.com/in/{{ site.social.linkedin }}",
      "{{ site.url }}"
    ]
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.url }}/{{ page.lang }}?search={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "publisher": {
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.author.logo.url }}"
    }
  }
}
